@@ -0,0 +1,74 @@
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { opencodeAgentDef } from '../../src/runtimes/defs/opencode.js';
+
+const execAgentFileMock = vi.hoisted(() => vi.fn());
+vi.mock('../../src/runtimes/invocation.js', () => ({
+  execAgentFile: execAgentFileMock,
+}));
+
+function unrecognizedFlag(flag: string): Error & { stderr: string; code: number } {
+  return Object.assign(new Error(`Command failed: opencode models ${flag}`), {
+    stderr: `ERROR\n  Unrecognized flag: ${flag} in command opencode models\n`,
+    code: 1,
+  });
+}
+
+describe('opencode model discovery', () => {
+  beforeEach(() => {
+    execAgentFileMock.mockReset();
+  });
+
+  it('reads variant metadata from `models --verbose` on OpenCode 1.x', async () => {
+    execAgentFileMock.mockResolvedValue({
+      stdout: ['openai/gpt-5.6-sol', '{ "variants": { "high": {} } }', 'openai/gpt-5'].join('\n'),
+      stderr: '',
+    });
+
+    const models = await opencodeAgentDef.fetchModels!('/opt/opencode', { PATH: '/usr/bin' });
+
+    expect(execAgentFileMock).toHaveBeenCalledTimes(1);
+    expect(execAgentFileMock).toHaveBeenCalledWith(
+      '/opt/opencode',
+      ['models', '--verbose'],
+      expect.objectContaining({ env: { PATH: '/usr/bin' } }),
+    );
+    expect(models?.find((model) => model.id === 'openai/gpt-5.6-sol')?.reasoningOptions).toEqual([
+      { id: 'default', label: 'Default' },
+      { id: 'high', label: 'high' },
+    ]);
+  });
+
+  it('falls back to the plain listing when OpenCode 2.x rejects --verbose', async () => {
+    execAgentFileMock
+      .mockRejectedValueOnce(unrecognizedFlag('--verbose'))
+      .mockResolvedValueOnce({ stdout: 'openai/gpt-5\nanthropic/claude-sonnet-4-5\n', stderr: '' });
+
+    const models = await opencodeAgentDef.fetchModels!('/opt/opencode', {});
+
+    expect(execAgentFileMock.mock.calls.map((call) => call[1])).toEqual([
+      ['models', '--verbose'],
+      ['models'],
+    ]);
+    expect(models?.map((model) => model.id)).toEqual([
+      'default',
+      'openai/gpt-5',
+      'anthropic/claude-sonnet-4-5',
+    ]);
+  });
+
+  it('returns null when neither listing is usable', async () => {
+    execAgentFileMock.mockRejectedValue(new Error('spawn ENOENT'));
+
+    await expect(opencodeAgentDef.fetchModels!('/opt/opencode', {})).resolves.toBeNull();
+  });
+
+  it('does not retry the plain listing after a timeout or crash of the verbose one', async () => {
+    // Only "this build does not know --verbose" justifies a second spawn;
+    // a slow registry must not double the detection budget.
+    execAgentFileMock.mockRejectedValue(Object.assign(new Error('timed out'), { killed: true, signal: 'SIGKILL' }));
+
+    await expect(opencodeAgentDef.fetchModels!('/opt/opencode', {})).resolves.toBeNull();
+    expect(execAgentFileMock).toHaveBeenCalledTimes(1);
+  });
+});
diff --git a/apps/daemon/tests/runtimes/opencode-permissions.test.ts b/apps/daemon/tests/runtimes/opencode-permissions.test.ts
new file mode 100644
index 000000000..6222d227c
--- /dev/null
+++ b/apps/daemon/tests/runtimes/opencode-permissions.test.ts
@@ -0,0 +1,129 @@
+import { afterEach, describe, expect, it } from 'vitest';
+
+import { agentCapabilities } from '../../src/runtimes/capabilities.js';
+import {
+  OPENCODE_PERMISSION_CAPABILITY,
+  appendOpenCodePermissionBypass,
+  appendOpenCodeStandalone,
+  appendOpenCodeWorkspaceDir,
+  openCodeModelArgs,
+  resolveOpenCodeCliGeneration,
+  shouldUseOpenCodePureFlag,
+  withOpenCodeWorkspaceEnv,
+} from '../../src/runtimes/opencode-permissions.js';
+
+// Capability maps as the `run --help` substring probe records them.
+const V1_CAPS = {
+  skipPermissions: true,
+  autoApprove: false,
+  workspaceDir: true,
+  pure: true,
+  variant: true,
+  standalone: false,
+};
+const V2_CAPS = {
+  skipPermissions: false,
+  autoApprove: true,
+  workspaceDir: false,
+  pure: false,
+  variant: false,
+  standalone: true,
+};
+
+describe('OpenCode CLI generation', () => {
+  afterEach(() => {
+    agentCapabilities.delete('opencode');
+  });
+
+  it('probes every flag whose presence differs between OpenCode 1.x and 2.x', () => {
+    expect(OPENCODE_PERMISSION_CAPABILITY.helpArgs).toEqual(['run', '--help']);
+    expect(OPENCODE_PERMISSION_CAPABILITY.capabilityFlags).toEqual({
+      '--dangerously-skip-permissions': 'skipPermissions',
+      '--auto': 'autoApprove',
+      '--dir': 'workspaceDir',
+      '--pure': 'pure',
+      '--variant': 'variant',
+      '--standalone': 'standalone',
+    });
+  });
+
+  it('resolves the generation from the workspace-dir flag alone', () => {
+    expect(resolveOpenCodeCliGeneration('opencode')).toBe('unknown');
+    agentCapabilities.set('opencode', {});
+    expect(resolveOpenCodeCliGeneration('opencode')).toBe('unknown');
+    agentCapabilities.set('opencode', V1_CAPS);
+    expect(resolveOpenCodeCliGeneration('opencode')).toBe('v1');
+    agentCapabilities.set('opencode', V2_CAPS);
+    expect(resolveOpenCodeCliGeneration('opencode')).toBe('v2');
+  });
+
+  it('keeps the 1.x argv while the probe has not answered', () => {
+    const args: string[] = [];
+    appendOpenCodePermissionBypass(args, 'opencode');
+    appendOpenCodeWorkspaceDir(args, '/projects/p1', 'opencode');
+    appendOpenCodeStandalone(args, 'opencode');
+    expect(args).toEqual(['--dir', '/projects/p1']);
+    expect(shouldUseOpenCodePureFlag('opencode')).toBe(true);
+    expect(openCodeModelArgs('openai/gpt-5', 'high', 'opencode')).toEqual([
+      '-m', 'openai/gpt-5', '--variant', 'high',
+    ]);
+  });
+
+  it('sends the 1.x flags when the probe advertises them', () => {
+    agentCapabilities.set('opencode', V1_CAPS);
+    const args: string[] = [];
+    appendOpenCodePermissionBypass(args, 'opencode');
+    appendOpenCodeWorkspaceDir(args, '/projects/p1', 'opencode');
+    appendOpenCodeStandalone(args, 'opencode');
+    expect(args).toEqual(['--dangerously-skip-permissions', '--dir', '/projects/p1']);
+    expect(shouldUseOpenCodePureFlag('opencode')).toBe(true);
+  });
+
+  it('switches to the 2.x surface when `run --help` lacks --dir', () => {
+    agentCapabilities.set('opencode', V2_CAPS);
+    const args: string[] = [];
+    appendOpenCodePermissionBypass(args, 'opencode');
+    appendOpenCodeWorkspaceDir(args, '/projects/p1', 'opencode');
+    appendOpenCodeStandalone(args, 'opencode');
+    expect(args).toEqual(['--auto', '--standalone']);
+    expect(shouldUseOpenCodePureFlag('opencode')).toBe(false);
+    expect(openCodeModelArgs('openai/gpt-5', 'high', 'opencode')).toEqual([
+      '-m', 'openai/gpt-5#high',
+    ]);
+    expect(openCodeModelArgs('openai/gpt-5', null, 'opencode')).toEqual(['-m', 'openai/gpt-5']);
+  });
+
+  it('never adds --auto to a 1.x argv, even when the substring probe saw it', () => {
+    // The probe is a substring scan of the help text; a 1.x build whose help
+    // happens to contain `--auto` must keep its byte-for-byte 1.x argv.
+    agentCapabilities.set('opencode', { ...V1_CAPS, skipPermissions: false, autoApprove: true });
+    const args: string[] = [];
+    appendOpenCodePermissionBypass(args, 'opencode');
+    expect(args).toEqual([]);
+  });
+
+  it('does not send --standalone to a 2.x build that does not advertise it', () => {
+    agentCapabilities.set('opencode', { ...V2_CAPS, standalone: false });
+    const args: string[] = [];
+    appendOpenCodeStandalone(args, 'opencode');
+    expect(args).toEqual([]);
+  });
+
+  it('pins PWD to the project directory only for a 2.x launch', () => {
+    const inherited = { PATH: '/usr/bin', PWD: '/repo/open-design' };
+
+    expect(withOpenCodeWorkspaceEnv(inherited, '/repo/open-design/.od/projects/p1', 'opencode'))
+      .toEqual(inherited);
+
+    agentCapabilities.set('opencode', V1_CAPS);
+    expect(withOpenCodeWorkspaceEnv(inherited, '/repo/open-design/.od/projects/p1', 'opencode'))
+      .toEqual(inherited);
+
+    agentCapabilities.set('opencode', V2_CAPS);
+    const pinned = withOpenCodeWorkspaceEnv(inherited, '/repo/open-design/.od/projects/p1', 'opencode');
+    expect(pinned).toEqual({ PATH: '/usr/bin', PWD: '/repo/open-design/.od/projects/p1' });
+    // The inherited environment is left untouched.
+    expect(inherited.PWD).toBe('/repo/open-design');
+    expect(withOpenCodeWorkspaceEnv(inherited, '', 'opencode')).toEqual(inherited);
+  });
+});
diff --git a/apps/daemon/tests/runtimes/runtime-capability-scope.test.ts b/apps/daemon/tests/runtimes/runtime-capability-scope.test.ts
new file mode 100644
index 000000000..cd7c5f8f6
--- /dev/null
+++ b/apps/daemon/tests/runtimes/runtime-capability-scope.test.ts
@@ -0,0 +1,102 @@
+import { chmodSync, existsSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+import { agentCapabilities } from '../../src/runtimes/capabilities.js';
+import { ensureDetectedRuntimeCapabilities } from '../../src/runtimes/detection.js';
+
+// A stand-in OpenCode whose `run --help` output is chosen per call. The 1.x
+// text advertises `--dir`; the 2.x text does not.
+const HELP_1X = 'FLAGS\n  --dir string  Directory\n  --pure  Skip plugins\n';
+const HELP_2X = 'FLAGS\n  --auto  Auto-approve permissions\n  --standalone  Private server\n';
+
+function fakeOpenCode(dir: string, body: string): string {
+  const bin = path.join(dir, 'opencode');
+  writeFileSync(bin, `#!/usr/bin/env node\n${body}`);
+  chmodSync(bin, 0o755);
+  return bin;
+}
+
+function helpScript(help: string): string {
+  return `
+const args = process.argv.slice(2);
+if (args.includes('--version')) { console.log('opencode fake'); process.exit(0); }
+if (args.includes('--help')) { console.error(${JSON.stringify(help)}); process.exit(0); }
+process.exit(0);
+`;
+}
+
+describe('OpenCode capability cache', () => {
+  const dirs: string[] = [];
+  afterEach(() => {
+    agentCapabilities.delete('opencode');
+    for (const dir of dirs.splice(0)) rmSync(dir, { recursive: true, force: true });
+  });
+
+  it('re-probes after the binary at the same path changes (in-place upgrade)', async () => {
+    const dir = mkdtempSync(path.join(os.tmpdir(), 'od-opencode-scope-'));
+    dirs.push(dir);
+    const bin = fakeOpenCode(dir, helpScript(HELP_1X));
+    const env = { OPENCODE_BIN: bin };
+
+    await expect(ensureDetectedRuntimeCapabilities('opencode', env))
+      .resolves.toMatchObject({ workspaceDir: true, autoApprove: false });
+
+    // OpenCode self-updates in place: same path, new bytes.
+    fakeOpenCode(dir, helpScript(HELP_2X));
+
+    await expect(ensureDetectedRuntimeCapabilities('opencode', env))
+      .resolves.toMatchObject({ workspaceDir: false, autoApprove: true });
+  });
+
+  it('retries a failed --help probe only after the retry window, not on every launch', async () => {
+    const dir = mkdtempSync(path.join(os.tmpdir(), 'od-opencode-probe-'));
+    dirs.push(dir);
+    const ready = path.join(dir, 'ready');
+    const calls = path.join(dir, 'calls');
+    // Same bytes on disk throughout; behaviour flips on a side file, so the
+    // cache scope cannot tell the calls apart.
+    const bin = fakeOpenCode(dir, `
+const fs = require('node:fs');
+const args = process.argv.slice(2);
+if (args.includes('--version')) { console.log('opencode fake'); process.exit(0); }
+if (args.includes('--help')) {
+  fs.appendFileSync(${JSON.stringify(calls)}, 'x');
+  if (!fs.existsSync(${JSON.stringify(ready)})) process.exit(1);
+  console.error(${JSON.stringify(HELP_2X)});
+  process.exit(0);
+}
+process.exit(0);
+`);
+    const env = { OPENCODE_BIN: bin };
+    const helpProbes = (): number => (existsSync(calls) ? readFileSync(calls, 'utf8').length : 0);
+    const now = Date.now();
+    const clock = vi.spyOn(Date, 'now').mockReturnValue(now);
+    try {
+      // A transient failure (timeout, crash during a cold start) yields no
+      // flags at all, which buildArgs reads as "unknown".
+      await expect(ensureDetectedRuntimeCapabilities('opencode', env)).resolves.toEqual({});
+      expect(helpProbes()).toBe(1);
+
+      // Inside the window the empty answer is served from cache: a chat run,
+      // its automatic retry, its memory extraction and its evidence export
+      // must not each pay the bounded probe again (a CLI that hangs on --help
+      // costs 5s per read, and a retry starts well after the first launch).
+      writeFileSync(ready, '');
+      clock.mockReturnValue(now + 30_000);
+      await expect(ensureDetectedRuntimeCapabilities('opencode', env)).resolves.toEqual({});
+      expect(helpProbes()).toBe(1);
+
+      // Once the window elapses the probe runs again, so a failed read is not
+      // the daemon-lifetime answer that pins the 1.x argv onto a 2.x CLI.
+      clock.mockReturnValue(now + 60_001);
+      await expect(ensureDetectedRuntimeCapabilities('opencode', env))
+        .resolves.toMatchObject({ workspaceDir: false, autoApprove: true });
+      expect(helpProbes()).toBe(2);
+    } finally {
+      clock.mockRestore();
+    }
+  });
+});
