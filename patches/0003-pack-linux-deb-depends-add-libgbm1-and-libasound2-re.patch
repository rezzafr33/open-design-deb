Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

---
 tools/pack/src/linux.ts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/tools/pack/src/linux.ts b/tools/pack/src/linux.ts
index cc7523810..121f52a32 100644
--- a/tools/pack/src/linux.ts
+++ b/tools/pack/src/linux.ts
@@ -846,6 +846,10 @@ async function writeLinuxBuilderConfig(config: ToolPackConfig, paths: LinuxPaths
               // so declare it explicitly (lintian: missing-dependency-on-libc).
               "libc6",
               "libgtk-3-0 | libgtk-3-0t64",
+              // Chromium links these directly (Ozone GPU + ALSA audio); the
+              // electron-builder baseline omits them like it omits libc6.
+              "libgbm1",
+              "libasound2 | libasound2t64",
               "libnotify4",
               "libnss3",
               "libxss1",
