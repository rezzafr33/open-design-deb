From 700dd7615ae7dd4d80782a4025b87bad134e60a4 Mon Sep 17 00:00:00 2001
From: Kacper Paczos <kacperpaczos2024@proton.me>
Date: Tue, 6 Oct 2026 12:46:27 +0200
Subject: [PATCH 09/14] fix(flatpak): resolve packaged executable name
 (portable builds rename it)

---
 packaging/flatpak/io.open-design.desktop.json | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/packaging/flatpak/io.open-design.desktop.json b/packaging/flatpak/io.open-design.desktop.json
index cfcc4a486..380c2dbf6 100644
--- a/packaging/flatpak/io.open-design.desktop.json
+++ b/packaging/flatpak/io.open-design.desktop.json
@@ -24,8 +24,8 @@
             "buildsystem": "simple",
             "build-commands": [
                 "mkdir -p /app/open-design /app/bin /app/lib /app/share/applications /app/share/icons/hicolor/512x512/apps",
-                "cp -aT . /app/open-design",
-                "cat > /app/bin/open-design <<'EOF'\n#!/bin/bash\n# Open Design Flatpak launcher.\nAPP=\"/app/open-design/Open Design\"\n# The sidecar daemon and spawned agent CLIs expect a reachable session\n# bus; flatpak scrubs the variable when it is not set explicitly.\nexport DBUS_SESSION_BUS_ADDRESS=\"${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}\"\n# Electron's chrome-sandbox cannot work inside the Flatpak sandbox, so\n# apps normally route through zypak (shipped by the Electron BaseApp).\n# zypak 26.08 however re-spawns app children inside its own bwrap\n# sandbox with a scrubbed environment; this app's sidecar supervisor\n# then SIGABRTs in zypak-helper while probing the D-Bus portal\n# (DetermineZygoteStrategy). Until that interplay is resolved, disable\n# Chromium's INNER sandbox and rely on the Flatpak sandbox as the outer\n# boundary (documented in packaging/flatpak/README.md).\nexport ELECTRON_DISABLE_SANDBOX=1\nexec \"$APP\" \"$@\"\nEOF\nchmod +x /app/bin/open-design",
+                "cp -aT . /app/open-design && ln -sfn \"$(ls /app/open-design | grep -xE 'Open Design|open-design' | head -n1)\" /app/open-design/app-bin",
+                "cat > /app/bin/open-design <<'EOF'\n#!/bin/bash\n# Open Design Flatpak launcher.\nAPP=\"/app/open-design/app-bin\"\n# The sidecar daemon and spawned agent CLIs expect a reachable session\n# bus; flatpak scrubs the variable when it is not set explicitly.\nexport DBUS_SESSION_BUS_ADDRESS=\"${DBUS_SESSION_BUS_ADDRESS:-unix:path=$XDG_RUNTIME_DIR/bus}\"\n# Electron's chrome-sandbox cannot work inside the Flatpak sandbox, so\n# apps normally route through zypak (shipped by the Electron BaseApp).\n# zypak 26.08 however re-spawns app children inside its own bwrap\n# sandbox with a scrubbed environment; this app's sidecar supervisor\n# then SIGABRTs in zypak-helper while probing the D-Bus portal\n# (DetermineZygoteStrategy). Until that interplay is resolved, disable\n# Chromium's INNER sandbox and rely on the Flatpak sandbox as the outer\n# boundary (documented in packaging/flatpak/README.md).\nexport ELECTRON_DISABLE_SANDBOX=1\nexec \"$APP\" \"$@\"\nEOF\nchmod +x /app/bin/open-design",
                 "cat > /app/share/applications/io.opendesign.desktop.desktop <<'EOF'\n[Desktop Entry]\nType=Application\nName=Open Design\nGenericName=Open Design\nComment=AI-native design agent workspace (community Flatpak build)\nExec=open-design\nIcon=io.opendesign.desktop\nCategories=Development;Utility;\nStartupWMClass=Open Design\nStartupNotify=true\nTerminal=false\nMimeType=x-scheme-handler/od;\nX-Flatpak=io.opendesign.desktop\nEOF",
                 "gdk-pixbuf-thumbnailer -s 512 icon.png icon-512.png",
                 "install -Dm644 icon-512.png /app/share/icons/hicolor/512x512/apps/io.opendesign.desktop.png"
-- 
2.55.0

